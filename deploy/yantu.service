[Unit]
Description=Beikaotai 2027 exam practice
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yantu
Group=yantu
WorkingDirectory=/srv/yantu/app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=/etc/yantu.env
ExecStart=/usr/local/bin/node /srv/yantu/app/node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/yantu/app/data /srv/yantu/app/.next
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
